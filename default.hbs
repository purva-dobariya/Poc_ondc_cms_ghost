<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>

    <link rel="stylesheet" href="{{asset "css/style.css"}}">

    {{!-- Colours chosen in Ghost Admin > Settings > Design & branding > Theme --}}
    <style>
        :root {
            --ondc-button: {{@custom.button_color}};
            --ondc-hero: {{@custom.hero_background}};
            --ondc-link: {{@custom.link_color}};
        }
    </style>

    {{ghost_head}}
</head>

<body class="{{body_class}}">

    <!-- Header -->
    <header class="header">
        <div class="container header-inner">
            <a class="logo" href="{{@site.url}}">{{@custom.logo_text}}</a>

            {{!-- The menu is edited in Ghost Admin > Settings > Navigation (markup in partials/navigation.hbs) --}}
            <nav>
                {{navigation}}
            </nav>
        </div>
    </header>

    {{{body}}}

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>{{@custom.footer_text}}</p>
        </div>
    </footer>

    <script src="{{asset "js/main.js"}}"></script>
    {{ghost_foot}}
</body>
</html>
